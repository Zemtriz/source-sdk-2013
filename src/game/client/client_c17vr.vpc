$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"c17vr" [!$SOURCESDK]
$Macro GAMENAME 	"mod_c17vr" [$SOURCESDK]

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE;.\c17vr;$SRCDIR\game\shared\c17vr;.\hl2;.\hl2\elements;$SRCDIR\game\shared\hl2;.\hl2mp\ui;.\hl2mp;$SRCDIR\game\shared\hl2mp"
		$PreprocessorDefinitions			"$BASE;C17VR;HL2_CLIENT_DLL;NEXT_BOT;HL2MP"
	}
}

